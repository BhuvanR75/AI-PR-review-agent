# ---- backend/.env.example ----
# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=dev

# --- storage (docker compose maps to non-default host ports to avoid clashes) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/prreview
REDIS_URL=redis://localhost:6380/0

# --- github ---
# The HMAC secret you set on the GitHub App / webhook.
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
# Only needed when GITHUB_CLIENT_MODE=live.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# dry_run: never calls GitHub; reads PRs from .local/inbox, writes posts to .local/outbox.
GITHUB_CLIENT_MODE=dry_run
OUTBOX_DIR=.local/outbox
INBOX_DIR=.local/inbox

# --- security ---
# There is nothing to configure here on purpose. Credential-shaped literals are
# redacted from prompts and untrusted text is scanned for instruction-injection markers
# on every pass; a switch that turns that off would only ever be used to turn it off.
# The threat model this implements is at GET /api/meta/threat-model.

# --- llm ---
# fake: offline deterministic reviewer (default, so the whole spine runs with no keys)
# openai: real structured-output calls
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_ROUTES=security=gpt-4o-mini,quality=gpt-4o-mini,tests=gpt-4o-mini,docs=gpt-4o-mini,aggregator=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# --- embeddings ---
# fake: deterministic hashing embedder (offline). openai: text-embedding-3-large.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=256

# --- retrieval ---
TOP_K_CHUNKS=12
RRF_K=60

# --- orchestration ---
AGENT_TIMEOUT_SECONDS=90
RECURSION_LIMIT=25

# --- human in the loop ---
# always: every review waits for human approval (default, per the study's advice to
#   start with more involvement than you think you need)
# confidence_gated: post automatically when confident and free of CRITICAL findings
HITL_MODE=always
HITL_CONFIDENCE_THRESHOLD=0.75
MAX_COMMENTS_PER_REVIEW=20

# --- economics ---
DAILY_BUDGET_USD=25
COST_PER_1K_INPUT_TOKENS=0.00015
COST_PER_1K_OUTPUT_TOKENS=0.0006

# --- api ---
# Shared bearer token for the approval console / CLI in dev. Real RBAC is deferred.
API_TOKEN=dev-api-token
CORS_ORIGINS=http://localhost:3000
