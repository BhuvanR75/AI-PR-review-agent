# Copy to .env.local

# Where the FastAPI backend is listening. The compose default is 8080.
NEXT_PUBLIC_API_BASE=http://localhost:8080

# The same value as API_TOKEN on the backend.
#
# This is exposed to the browser on purpose -- the console runs locally and has to
# authenticate itself -- and it is the honest limit of the current auth model: one
# shared token, no per-user identity. Do not deploy this console to a public host
# with this token in the bundle. See the README's "Security posture" section.
NEXT_PUBLIC_API_TOKEN=dev-api-token
